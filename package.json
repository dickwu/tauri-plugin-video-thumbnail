{
  "name": "tauri-plugin-video-thumbnail",
  "version": "0.1.0",
  "author": "Peilin Wu",
  "description": "Generate video thumbnails from URLs or local paths for Tauri applications",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dickwu/tauri-plugin-video-thumbnail.git"
  },
  "homepage": "https://github.com/dickwu/tauri-plugin-video-thumbnail#readme",
  "bugs": {
    "url": "https://github.com/dickwu/tauri-plugin-video-thumbnail/issues"
  },
  "keywords": [
    "tauri",
    "tauri-plugin",
    "video",
    "thumbnail",
    "ffmpeg",
    "rust"
  ],
  "type": "module",
  "types": "./dist-js/index.d.ts",
  "main": "./dist-js/index.cjs",
  "module": "./dist-js/index.js",
  "exports": {
    ".": {
      "types": "./dist-js/index.d.ts",
      "import": "./dist-js/index.js",
      "require": "./dist-js/index.cjs"
    }
  },
  "files": [
    "dist-js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "prepublishOnly": "pnpm build",
    "pretest": "pnpm build"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "rollup": "^4.9.6",
    "typescript": "^5.3.3",
    "tslib": "^2.6.2"
  },
  "engines": {
    "node": ">=18"
  }
}
